//@version=6
strategy("v8.1α-ZZ-MTA-B5.2 Strategy v1.0 - 15m ZZ-MTA Setup + Fixed Pre Pivot Break", overlay = true, initial_capital = 1000000, default_qty_type = strategy.percent_of_equity, default_qty_value = 2, commission_type = strategy.commission.percent, commission_value = 0.04, slippage = 2, pyramiding = 0, process_orders_on_close = false, calc_on_every_tick = false, max_labels_count = 500, max_lines_count = 500, max_bars_back = 5000)

//=============================================================================
// Inputs
//=============================================================================

htfTf = input.timeframe("15", "ZZ-MTA計算時間足", group = "HTF ZZ-MTA")

reversalMode = input.string("ATR", "ZigZag反転幅モード", options = ["ATR", "Ticks", "Percent"], group = "ZigZag Confirmed Engine")

atrLength = input.int(14, "ATR Length", minval = 1, group = "ZigZag Confirmed Engine")
atrMultiplier = input.float(2.0, "ATR倍率", minval = 0.1, step = 0.1, group = "ZigZag Confirmed Engine")

reversalTicks = input.int(100, "固定Ticks反転幅", minval = 1, group = "ZigZag Confirmed Engine")
reversalPercent = input.float(0.1, "Percent反転幅", minval = 0.01, step = 0.01, group = "ZigZag Confirmed Engine")

triggerLeftBars = input.int(6, "1分Trigger 左ピボット本数", minval = 1, group = "B5.2 Trigger")
triggerRightBars = input.int(6, "1分Trigger 右ピボット本数", minval = 1, group = "B5.2 Trigger")
triggerExpireMinutes = input.int(120, "Trigger有効期限（分）", minval = 1, group = "B5.2 Trigger")

rr = input.float(1.0, "利確RR", minval = 0.1, step = 0.1, group = "Strategy")

showHtfMtaZone = input.bool(true, "HTF ZZ-MTAゾーンを表示", group = "表示")
showHtfMtaLine = input.bool(true, "HTF ZZ-MTAラインを表示", group = "表示")
showHtfAnchorLine = input.bool(true, "HTF対応高値/安値ラインを表示", group = "表示")

showSetupLabels = input.bool(true, "Setupラベルを表示", group = "表示")
showTriggerLabels = input.bool(true, "Triggerラベルを表示", group = "表示")
showInvalidLabels = input.bool(true, "Setup失効ラベルを表示", group = "表示")
showTriggerPivots = input.bool(true, "1分Trigger基準H/Lを表示", group = "表示")
showEntryLabels = input.bool(true, "Entryラベルを表示", group = "表示")
showDebug = input.bool(false, "状態をデータウィンドウに表示", group = "Debug")

bullMtaColor = input.color(color.blue, "Bull MTA色", group = "色")
bearMtaColor = input.color(color.fuchsia, "Bear MTA色", group = "色")
endedMtaColor = input.color(color.gray, "終了MTA色", group = "色")
anchorColor = input.color(color.orange, "対応高値/安値色", group = "色")

setupLongColor = input.color(color.green, "Long Setup色", group = "色")
setupShortColor = input.color(color.red, "Short Setup色", group = "色")
triggerLongColor = input.color(color.lime, "Long Trigger色", group = "色")
triggerShortColor = input.color(color.red, "Short Trigger色", group = "色")

//=============================================================================
// HTF ZZ-MTA Engine Helper Functions
//=============================================================================

reversalAmount(refPrice) =>
    float atrValueLocal = ta.atr(atrLength)
    float result = na
    if reversalMode == "ATR"
        result := atrValueLocal * atrMultiplier
    if reversalMode == "Ticks"
        result := reversalTicks * syminfo.mintick
    if reversalMode == "Percent"
        result := refPrice * reversalPercent / 100.0
    result

mtaBodyHighMaxFromBar(mtaBar) =>
    float result = na
    int barsBack = bar_index - mtaBar
    int limit = math.min(barsBack, 500)
    if limit >= 0
        for i = 0 to limit
            bodyHigh = math.max(open[i], close[i])
            result := na(result) ? bodyHigh : math.max(result, bodyHigh)
    result

mtaBodyLowMinFromBar(mtaBar) =>
    float result = na
    int barsBack = bar_index - mtaBar
    int limit = math.min(barsBack, 500)
    if limit >= 0
        for i = 0 to limit
            bodyLow = math.min(open[i], close[i])
            result := na(result) ? bodyLow : math.min(result, bodyLow)
    result

//=============================================================================
// HTF ZZ-MTA Engine
// ZigZag Engine = 0.1 fixed
// MTA Line = 0.2.1 fixed
// Zone = 0.3 fixed
//=============================================================================

calcZzMta() =>
    var int swingDir = 0

    var float rangeHigh = na
    var int rangeHighBar = na
    var int rangeHighTime = na

    var float rangeLow = na
    var int rangeLowBar = na
    var int rangeLowTime = na

    var float candidateHigh = na
    var int candidateHighBar = na
    var int candidateHighTime = na

    var float candidateLow = na
    var int candidateLowBar = na
    var int candidateLowTime = na

    var array<float> zzPrices = array.new_float()
    var array<int> zzTypes = array.new_int()
    var array<int> zzBars = array.new_int()
    var array<int> zzTimes = array.new_int()

    var int mtaTrend = 0
    var float mtaPrice = na
    var int mtaBar = na
    var int mtaTime = na
    var float mtaZoneTop = na
    var float mtaZoneBottom = na

    var float anchorPrice = na
    var int anchorBar = na
    var int anchorTime = na

    bool confirmedSwing = false
    int confirmedType = 0
    float confirmedPrice = na
    int confirmedBar = na
    int confirmedTime = na

    bool mtaStarted = false
    bool mtaEnded = false

    if barstate.isconfirmed
        confirmedSwing := false
        confirmedType := 0
        confirmedPrice := na
        confirmedBar := na
        confirmedTime := na

        mtaStarted := false
        mtaEnded := false

        if na(rangeHigh)
            rangeHigh := high
            rangeHighBar := bar_index
            rangeHighTime := time

        if na(rangeLow)
            rangeLow := low
            rangeLowBar := bar_index
            rangeLowTime := time

        if swingDir == 0
            if high > rangeHigh
                rangeHigh := high
                rangeHighBar := bar_index
                rangeHighTime := time

            if low < rangeLow
                rangeLow := low
                rangeLowBar := bar_index
                rangeLowTime := time

            float initAmount = reversalAmount(close)
            bool canStartUp = not na(initAmount) and rangeHigh - rangeLow >= initAmount and close >= open
            bool canStartDown = not na(initAmount) and rangeHigh - rangeLow >= initAmount and close < open

            if canStartUp
                confirmedSwing := true
                confirmedType := -1
                confirmedPrice := rangeLow
                confirmedBar := rangeLowBar
                confirmedTime := rangeLowTime

                swingDir := 1
                candidateHigh := rangeHigh
                candidateHighBar := rangeHighBar
                candidateHighTime := rangeHighTime
                candidateLow := na
                candidateLowBar := na
                candidateLowTime := na

            if canStartDown
                confirmedSwing := true
                confirmedType := 1
                confirmedPrice := rangeHigh
                confirmedBar := rangeHighBar
                confirmedTime := rangeHighTime

                swingDir := -1
                candidateLow := rangeLow
                candidateLowBar := rangeLowBar
                candidateLowTime := rangeLowTime
                candidateHigh := na
                candidateHighBar := na
                candidateHighTime := na

        if swingDir == 1
            if na(candidateHigh)
                candidateHigh := high
                candidateHighBar := bar_index
                candidateHighTime := time

            if high > candidateHigh
                candidateHigh := high
                candidateHighBar := bar_index
                candidateHighTime := time

            float upAmount = reversalAmount(candidateHigh)
            bool highConfirmed = not na(upAmount) and candidateHigh - low >= upAmount

            if highConfirmed
                confirmedSwing := true
                confirmedType := 1
                confirmedPrice := candidateHigh
                confirmedBar := candidateHighBar
                confirmedTime := candidateHighTime

                swingDir := -1
                candidateLow := low
                candidateLowBar := bar_index
                candidateLowTime := time
                candidateHigh := na
                candidateHighBar := na
                candidateHighTime := na

        if swingDir == -1
            if na(candidateLow)
                candidateLow := low
                candidateLowBar := bar_index
                candidateLowTime := time

            if low < candidateLow
                candidateLow := low
                candidateLowBar := bar_index
                candidateLowTime := time

            float downAmount = reversalAmount(candidateLow)
            bool lowConfirmed = not na(downAmount) and high - candidateLow >= downAmount

            if lowConfirmed
                confirmedSwing := true
                confirmedType := -1
                confirmedPrice := candidateLow
                confirmedBar := candidateLowBar
                confirmedTime := candidateLowTime

                swingDir := 1
                candidateHigh := high
                candidateHighBar := bar_index
                candidateHighTime := time
                candidateLow := na
                candidateLowBar := na
                candidateLowTime := na

    if barstate.isconfirmed and confirmedSwing and not na(confirmedPrice) and not na(confirmedTime)
        bool canStore = true

        if array.size(zzTimes) > 0
            int lastTime = array.get(zzTimes, array.size(zzTimes) - 1)
            int lastType = array.get(zzTypes, array.size(zzTypes) - 1)

            if confirmedTime <= lastTime
                canStore := false

            if confirmedType == lastType
                canStore := false

        if canStore
            array.push(zzPrices, confirmedPrice)
            array.push(zzTypes, confirmedType)
            array.push(zzBars, confirmedBar)
            array.push(zzTimes, confirmedTime)

            if array.size(zzPrices) > 300
                array.shift(zzPrices)
                array.shift(zzTypes)
                array.shift(zzBars)
                array.shift(zzTimes)

    if barstate.isconfirmed
        int n = array.size(zzPrices)

        if mtaTrend == 0
            if n >= 3
                int t1 = array.get(zzTypes, n - 3)
                int t2 = array.get(zzTypes, n - 2)
                int t3 = array.get(zzTypes, n - 1)

                float p1 = array.get(zzPrices, n - 3)
                float p2 = array.get(zzPrices, n - 2)
                float p3 = array.get(zzPrices, n - 1)

                int b2 = array.get(zzBars, n - 2)
                int tm2 = array.get(zzTimes, n - 2)
                int b3 = array.get(zzBars, n - 1)
                int tm3 = array.get(zzTimes, n - 1)

                bool bullPattern = false
                bool bearPattern = false

                if t1 == -1
                    if t2 == 1
                        if t3 == -1
                            if p3 > p1
                                if close > p2
                                    bullPattern := true

                if t1 == 1
                    if t2 == -1
                        if t3 == 1
                            if p3 < p1
                                if close < p2
                                    bearPattern := true

                if bullPattern
                    mtaTrend := 1
                    anchorPrice := p2
                    anchorBar := b2
                    anchorTime := tm2
                    mtaPrice := p3
                    mtaBar := b3
                    mtaTime := tm3
                    mtaZoneBottom := mtaPrice
                    mtaZoneTop := mtaBodyLowMinFromBar(mtaBar)
                    mtaStarted := true

                if bearPattern
                    mtaTrend := -1
                    anchorPrice := p2
                    anchorBar := b2
                    anchorTime := tm2
                    mtaPrice := p3
                    mtaBar := b3
                    mtaTime := tm3
                    mtaZoneTop := mtaPrice
                    mtaZoneBottom := mtaBodyHighMaxFromBar(mtaBar)
                    mtaStarted := true

        if mtaTrend == 1
            bool bullInvalid = false
            if not na(mtaPrice)
                if close < mtaPrice
                    bullInvalid := true

            if bullInvalid
                mtaTrend := 0
                mtaEnded := true
            else
                bool anchorBreak = false
                if not na(anchorPrice)
                    if close > anchorPrice
                        anchorBreak := true

                if anchorBreak
                    int breakHighIdx = -1

                    if n > 0
                        for j = 0 to n - 1
                            int tj = array.get(zzTypes, j)
                            int bj = array.get(zzBars, j)
                            float pj = array.get(zzPrices, j)

                            if tj == 1
                                if bj > anchorBar
                                    if pj > anchorPrice
                                        breakHighIdx := j

                    if breakHighIdx >= 0
                        int breakHighBar = array.get(zzBars, breakHighIdx)

                        float newLow = na
                        int newLowIdx = -1

                        if n > 0
                            for j = 0 to n - 1
                                int tj = array.get(zzTypes, j)
                                int bj = array.get(zzBars, j)
                                float pj = array.get(zzPrices, j)

                                if tj == -1
                                    if bj > anchorBar
                                        if bj < breakHighBar
                                            if na(newLow)
                                                newLow := pj
                                                newLowIdx := j
                                            else
                                                if pj < newLow
                                                    newLow := pj
                                                    newLowIdx := j

                        if newLowIdx >= 0
                            mtaPrice := array.get(zzPrices, newLowIdx)
                            mtaBar := array.get(zzBars, newLowIdx)
                            mtaTime := array.get(zzTimes, newLowIdx)
                            mtaZoneBottom := mtaPrice
                            mtaZoneTop := mtaBodyLowMinFromBar(mtaBar)

                            anchorPrice := array.get(zzPrices, breakHighIdx)
                            anchorBar := array.get(zzBars, breakHighIdx)
                            anchorTime := array.get(zzTimes, breakHighIdx)

                    if breakHighIdx < 0
                        float rollingLow = na
                        int rollingLowIdx = -1

                        if n > 0
                            for j = 0 to n - 1
                                int tj = array.get(zzTypes, j)
                                int bj = array.get(zzBars, j)
                                float pj = array.get(zzPrices, j)

                                if tj == -1
                                    if bj > anchorBar
                                        if na(rollingLow)
                                            rollingLow := pj
                                            rollingLowIdx := j
                                        else
                                            if pj < rollingLow
                                                rollingLow := pj
                                                rollingLowIdx := j

                        if rollingLowIdx >= 0
                            float candidateMta = array.get(zzPrices, rollingLowIdx)

                            bool shouldUpdateRolling = false
                            if na(mtaPrice)
                                shouldUpdateRolling := true
                            else
                                if candidateMta != mtaPrice
                                    shouldUpdateRolling := true

                            if shouldUpdateRolling
                                mtaPrice := candidateMta
                                mtaBar := array.get(zzBars, rollingLowIdx)
                                mtaTime := array.get(zzTimes, rollingLowIdx)
                                mtaZoneBottom := mtaPrice
                                mtaZoneTop := mtaBodyLowMinFromBar(mtaBar)

        if mtaTrend == -1
            bool bearInvalid = false
            if not na(mtaPrice)
                if close > mtaPrice
                    bearInvalid := true

            if bearInvalid
                mtaTrend := 0
                mtaEnded := true
            else
                bool anchorBreak = false
                if not na(anchorPrice)
                    if close < anchorPrice
                        anchorBreak := true

                if anchorBreak
                    int breakLowIdx = -1

                    if n > 0
                        for j = 0 to n - 1
                            int tj = array.get(zzTypes, j)
                            int bj = array.get(zzBars, j)
                            float pj = array.get(zzPrices, j)

                            if tj == -1
                                if bj > anchorBar
                                    if pj < anchorPrice
                                        breakLowIdx := j

                    if breakLowIdx >= 0
                        int breakLowBar = array.get(zzBars, breakLowIdx)

                        float newHigh = na
                        int newHighIdx = -1

                        if n > 0
                            for j = 0 to n - 1
                                int tj = array.get(zzTypes, j)
                                int bj = array.get(zzBars, j)
                                float pj = array.get(zzPrices, j)

                                if tj == 1
                                    if bj > anchorBar
                                        if bj < breakLowBar
                                            if na(newHigh)
                                                newHigh := pj
                                                newHighIdx := j
                                            else
                                                if pj > newHigh
                                                    newHigh := pj
                                                    newHighIdx := j

                        if newHighIdx >= 0
                            mtaPrice := array.get(zzPrices, newHighIdx)
                            mtaBar := array.get(zzBars, newHighIdx)
                            mtaTime := array.get(zzTimes, newHighIdx)
                            mtaZoneTop := mtaPrice
                            mtaZoneBottom := mtaBodyHighMaxFromBar(mtaBar)

                            anchorPrice := array.get(zzPrices, breakLowIdx)
                            anchorBar := array.get(zzBars, breakLowIdx)
                            anchorTime := array.get(zzTimes, breakLowIdx)

                    if breakLowIdx < 0
                        float rollingHigh = na
                        int rollingHighIdx = -1

                        if n > 0
                            for j = 0 to n - 1
                                int tj = array.get(zzTypes, j)
                                int bj = array.get(zzBars, j)
                                float pj = array.get(zzPrices, j)

                                if tj == 1
                                    if bj > anchorBar
                                        if na(rollingHigh)
                                            rollingHigh := pj
                                            rollingHighIdx := j
                                        else
                                            if pj > rollingHigh
                                                rollingHigh := pj
                                                rollingHighIdx := j

                        if rollingHighIdx >= 0
                            float candidateMta = array.get(zzPrices, rollingHighIdx)

                            bool shouldUpdateRolling = false
                            if na(mtaPrice)
                                shouldUpdateRolling := true
                            else
                                if candidateMta != mtaPrice
                                    shouldUpdateRolling := true

                            if shouldUpdateRolling
                                mtaPrice := candidateMta
                                mtaBar := array.get(zzBars, rollingHighIdx)
                                mtaTime := array.get(zzTimes, rollingHighIdx)
                                mtaZoneTop := mtaPrice
                                mtaZoneBottom := mtaBodyHighMaxFromBar(mtaBar)

    [mtaTrend, mtaPrice, mtaZoneTop, mtaZoneBottom, anchorPrice, mtaStarted, mtaEnded, array.size(zzPrices)]

//=============================================================================
// HTF ZZ-MTA request.security
//=============================================================================

[htfMtaTrend, htfMtaPrice, htfMtaZoneTop, htfMtaZoneBottom, htfAnchorPrice, htfMtaStarted, htfMtaEnded, htfZzCount] = request.security(syminfo.tickerid, htfTf, calcZzMta(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

bullActive = htfMtaTrend == 1
bearActive = htfMtaTrend == -1
mtaActive = bullActive or bearActive

mtaColor = bullActive ? bullMtaColor : bearActive ? bearMtaColor : endedMtaColor

zoneTopSeries = showHtfMtaZone and mtaActive ? htfMtaZoneTop : na
zoneBottomSeries = showHtfMtaZone and mtaActive ? htfMtaZoneBottom : na
mtaLineSeries = showHtfMtaLine and mtaActive ? htfMtaPrice : na
anchorLineSeries = showHtfAnchorLine and mtaActive ? htfAnchorPrice : na

zoneTopPlot = plot(zoneTopSeries, title = "HTF ZZ-MTA Zone Top", color = mtaColor, linewidth = 1, style = plot.style_linebr)
zoneBottomPlot = plot(zoneBottomSeries, title = "HTF ZZ-MTA Zone Bottom", color = mtaColor, linewidth = 1, style = plot.style_linebr)

fill(zoneTopPlot, zoneBottomPlot, color = showHtfMtaZone and mtaActive ? color.new(mtaColor, 85) : na)

plot(mtaLineSeries, title = "HTF ZZ-MTA Line", color = mtaColor, linewidth = 2, style = plot.style_linebr)
plot(anchorLineSeries, title = "HTF ZZ-MTA Anchor", color = anchorColor, linewidth = 1, style = plot.style_linebr)

//=============================================================================
// LTF B5.2 Trigger Engine
//=============================================================================

triggerPivotHigh = ta.pivothigh(high, triggerLeftBars, triggerRightBars)
triggerPivotLow = ta.pivotlow(low, triggerLeftBars, triggerRightBars)

isTriggerPivotHigh = not na(triggerPivotHigh)
isTriggerPivotLow = not na(triggerPivotLow)

triggerPivotBar = bar_index - triggerRightBars

var float latestPivotHigh = na
var int latestPivotHighBar = na
var float latestPivotLow = na
var int latestPivotLowBar = na

if isTriggerPivotHigh
    latestPivotHigh := triggerPivotHigh
    latestPivotHighBar := triggerPivotBar

if isTriggerPivotLow
    latestPivotLow := triggerPivotLow
    latestPivotLowBar := triggerPivotBar

bullZoneTouch = bullActive and not na(htfMtaZoneTop) and not na(htfMtaZoneBottom) and low <= htfMtaZoneTop and high >= htfMtaZoneBottom
bearZoneTouch = bearActive and not na(htfMtaZoneTop) and not na(htfMtaZoneBottom) and high >= htfMtaZoneBottom and low <= htfMtaZoneTop

bullZoneTouchOnce = bullZoneTouch and not bullZoneTouch[1]
bearZoneTouchOnce = bearZoneTouch and not bearZoneTouch[1]

var bool longSetupActive = false
var bool shortSetupActive = false
var bool longTriggerFired = false
var bool shortTriggerFired = false

var int longSetupTime = na
var int shortSetupTime = na

var float longBreakHigh = na
var int longBreakHighBar = na
var float shortBreakLow = na
var int shortBreakLowBar = na

var label setupLabel = na
var label longBreakLabel = na
var label shortBreakLabel = na

expireMs = triggerExpireMinutes * 60 * 1000

canStartNewSetup = not longSetupActive and not shortSetupActive

if bullZoneTouchOnce and canStartNewSetup
    longSetupActive := true
    shortSetupActive := false
    longTriggerFired := false
    shortTriggerFired := false
    longSetupTime := time
    shortSetupTime := na

    longBreakHigh := latestPivotHigh
    longBreakHighBar := latestPivotHighBar
    shortBreakLow := na
    shortBreakLowBar := na

    if not na(setupLabel)
        label.delete(setupLabel)
        setupLabel := na

    if not na(longBreakLabel)
        label.delete(longBreakLabel)
        longBreakLabel := na

    if not na(shortBreakLabel)
        label.delete(shortBreakLabel)
        shortBreakLabel := na

    if showSetupLabels
        setupLabel := label.new(bar_index, low, "Long Setup\n15m ZZ-MTA接触\nPre H Fixed", style = label.style_label_up, textcolor = color.white, color = setupLongColor, size = size.small)

    if showTriggerPivots
        if not na(longBreakHigh)
            if not na(longBreakHighBar)
                longBreakLabel := label.new(longBreakHighBar, longBreakHigh, "Pre Break H\nFixed", style = label.style_label_down, textcolor = color.white, color = color.orange, size = size.tiny)

if bearZoneTouchOnce and canStartNewSetup
    shortSetupActive := true
    longSetupActive := false
    shortTriggerFired := false
    longTriggerFired := false
    shortSetupTime := time
    longSetupTime := na

    shortBreakLow := latestPivotLow
    shortBreakLowBar := latestPivotLowBar
    longBreakHigh := na
    longBreakHighBar := na

    if not na(setupLabel)
        label.delete(setupLabel)
        setupLabel := na

    if not na(longBreakLabel)
        label.delete(longBreakLabel)
        longBreakLabel := na

    if not na(shortBreakLabel)
        label.delete(shortBreakLabel)
        shortBreakLabel := na

    if showSetupLabels
        setupLabel := label.new(bar_index, high, "Short Setup\n15m ZZ-MTA接触\nPre L Fixed", style = label.style_label_down, textcolor = color.white, color = setupShortColor, size = size.small)

    if showTriggerPivots
        if not na(shortBreakLow)
            if not na(shortBreakLowBar)
                shortBreakLabel := label.new(shortBreakLowBar, shortBreakLow, "Pre Break L\nFixed", style = label.style_label_up, textcolor = color.white, color = color.red, size = size.tiny)

longExpired = longSetupActive and not na(longSetupTime) and time - longSetupTime > expireMs
shortExpired = shortSetupActive and not na(shortSetupTime) and time - shortSetupTime > expireMs

longInvalidByHtfMta = longSetupActive and htfMtaTrend != 1
shortInvalidByHtfMta = shortSetupActive and htfMtaTrend != -1

if longExpired
    longSetupActive := false
    if showInvalidLabels
        label.new(bar_index, close, "Long Setup Expired\nPre H Released", style = label.style_label_left, textcolor = color.white, color = endedMtaColor, size = size.small)

if shortExpired
    shortSetupActive := false
    if showInvalidLabels
        label.new(bar_index, close, "Short Setup Expired\nPre L Released", style = label.style_label_left, textcolor = color.white, color = endedMtaColor, size = size.small)

if longInvalidByHtfMta
    longSetupActive := false
    if showInvalidLabels
        label.new(bar_index, low, "Long Setup Invalid\nZZ-MTA End\nPre H Released", style = label.style_label_up, textcolor = color.white, color = endedMtaColor, size = size.small)

if shortInvalidByHtfMta
    shortSetupActive := false
    if showInvalidLabels
        label.new(bar_index, high, "Short Setup Invalid\nZZ-MTA End\nPre L Released", style = label.style_label_down, textcolor = color.white, color = endedMtaColor, size = size.small)

longTrigger = false
shortTrigger = false

currentBodyHigh = math.max(open, close)
currentBodyLow = math.min(open, close)

if longSetupActive
    if not longTriggerFired
        if not na(longBreakHigh)
            if barstate.isconfirmed
                if currentBodyHigh > longBreakHigh
                    longTrigger := true
                    longTriggerFired := true
                    longSetupActive := false
                    if showTriggerLabels
                        label.new(bar_index, high, "Long Trigger\nPre H Body Break\nPre H Released", style = label.style_label_down, textcolor = color.white, color = triggerLongColor, size = size.normal)

if shortSetupActive
    if not shortTriggerFired
        if not na(shortBreakLow)
            if barstate.isconfirmed
                if currentBodyLow < shortBreakLow
                    shortTrigger := true
                    shortTriggerFired := true
                    shortSetupActive := false
                    if showTriggerLabels
                        label.new(bar_index, low, "Short Trigger\nPre L Body Break\nPre L Released", style = label.style_label_up, textcolor = color.white, color = triggerShortColor, size = size.normal)

//=============================================================================
// Strategy Entry / Exit
//=============================================================================

longEntrySignal = barstate.isconfirmed and longTrigger and bullActive and not na(htfMtaZoneBottom) and close > htfMtaZoneBottom and strategy.position_size == 0
shortEntrySignal = barstate.isconfirmed and shortTrigger and bearActive and not na(htfMtaZoneTop) and close < htfMtaZoneTop and strategy.position_size == 0

if longEntrySignal
    longStop = htfMtaZoneBottom
    longRisk = close - longStop
    if longRisk > syminfo.mintick
        longLimit = close + longRisk * rr
        strategy.entry("Long", strategy.long)
        strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = longLimit, qty_percent = 100)
        if showEntryLabels
            label.new(bar_index, low, "Long Entry\nSL: Zone Bottom\nRR " + str.tostring(rr), style = label.style_label_up, textcolor = color.white, color = triggerLongColor, size = size.small)

if shortEntrySignal
    shortStop = htfMtaZoneTop
    shortRisk = shortStop - close
    if shortRisk > syminfo.mintick
        shortLimit = close - shortRisk * rr
        strategy.entry("Short", strategy.short)
        strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = shortLimit, qty_percent = 100)
        if showEntryLabels
            label.new(bar_index, high, "Short Entry\nSL: Zone Top\nRR " + str.tostring(rr), style = label.style_label_down, textcolor = color.white, color = triggerShortColor, size = size.small)

//=============================================================================
// Plots / Debug
//=============================================================================

plotshape(showSetupLabels and bullZoneTouchOnce and canStartNewSetup, title = "Long Setup Start", style = shape.circle, location = location.belowbar, color = setupLongColor, size = size.tiny, text = "L-SET")
plotshape(showSetupLabels and bearZoneTouchOnce and canStartNewSetup, title = "Short Setup Start", style = shape.circle, location = location.abovebar, color = setupShortColor, size = size.tiny, text = "S-SET")

plotshape(showTriggerLabels and longTrigger, title = "Long Trigger B5.2", style = shape.triangleup, location = location.belowbar, color = triggerLongColor, size = size.small, text = "L-TRIG")
plotshape(showTriggerLabels and shortTrigger, title = "Short Trigger B5.2", style = shape.triangledown, location = location.abovebar, color = triggerShortColor, size = size.small, text = "S-TRIG")

setupState = longSetupActive ? 1 : shortSetupActive ? -1 : 0

plot(showDebug ? htfMtaTrend : na, title = "HTF ZZ-MTA Trend 1=Bull -1=Bear 0=Off", display = display.data_window)
plot(showDebug ? htfMtaPrice : na, title = "HTF ZZ-MTA Price", display = display.data_window)
plot(showDebug ? htfMtaZoneTop : na, title = "HTF ZZ-MTA Zone Top", display = display.data_window)
plot(showDebug ? htfMtaZoneBottom : na, title = "HTF ZZ-MTA Zone Bottom", display = display.data_window)
plot(showDebug ? htfAnchorPrice : na, title = "HTF ZZ-MTA Anchor", display = display.data_window)
plot(showDebug ? htfZzCount : na, title = "HTF Confirmed ZZ Count", display = display.data_window)

plot(showDebug ? setupState : na, title = "B5.2 Setup State L=1 S=-1 Off=0", display = display.data_window)
plot(showDebug ? (canStartNewSetup ? 1 : 0) : na, title = "Can Start New Setup", display = display.data_window)
plot(showDebug ? longBreakHigh : na, title = "Long Pre Break H Fixed", display = display.data_window)
plot(showDebug ? shortBreakLow : na, title = "Short Pre Break L Fixed", display = display.data_window)
plot(showDebug ? (longTrigger ? 1 : 0) : na, title = "Long Trigger", display = display.data_window)
plot(showDebug ? (shortTrigger ? -1 : 0) : na, title = "Short Trigger", display = display.data_window)
plot(showDebug ? (longEntrySignal ? 1 : 0) : na, title = "Long Entry Signal", display = display.data_window)
plot(showDebug ? (shortEntrySignal ? -1 : 0) : na, title = "Short Entry Signal", display = display.data_window)
